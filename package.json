{
  "name": "rb2spot",
  "version": "0.1.0",
  "description": "Sync rekordbox playlists to Spotify — multi-stage matching, resumable caching, and progress reporting",
  "license": "MIT",
  "author": "tomnz",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomnz/rb2spot.git"
  },
  "keywords": [
    "rekordbox",
    "spotify",
    "dj",
    "playlist",
    "sync",
    "cli"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "bin",
    "src",
    "config.example.yaml",
    "LICENSE",
    "README.md",
    "README.ja.md"
  ],
  "bin": {
    "rb2spot": "./bin/rb2spot.mjs"
  },
  "scripts": {
    "rb2spot": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "fast-xml-parser": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "music-metadata": "^11.12.3",
    "ora": "^8.0.1",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  },
  "contributors": [
    "Chiaki Uehira (original author of rekordbox2spotify)"
  ],
  "bugs": {
    "url": "https://github.com/tomnz/rb2spot/issues"
  },
  "homepage": "https://github.com/tomnz/rb2spot#readme"
}
